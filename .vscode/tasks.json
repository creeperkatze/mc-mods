{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run client",
			"type": "shell",
			"command": "./gradlew :${input:mod}:${input:minecraft}-${input:loader}:runClient",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Run all",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"runAll",
				{
					"value": "-PrunAll=${input:minecraft}-${input:loader}",
					"quoting": "strong"
				}
			],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Build all",
			"type": "shell",
			"command": "./gradlew build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Build mod",
			"type": "shell",
			"command": "./gradlew :${input:mod}:build",
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Generate sources",
			"type": "shell",
			"command": "./gradlew genSources",
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "mod",
			"type": "pickString",
			"description": "Mod",
			"options": ["accelerate", "rearrange", "organize", "gather", "illuminate", "resume"],
			"default": "accelerate"
		},
		{
			"id": "minecraft",
			"type": "pickString",
			"description": "Minecraft version",
			"options": ["26.3", "26.2", "1.21.11", "1.21.1"],
			"default": "26.3"
		},
		{
			"id": "loader",
			"type": "pickString",
			"description": "Loader",
			"options": ["fabric", "neoforge"],
			"default": "fabric"
		}
	]
}
