{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": ["Creeperkatze"],
	"contact": {
		"homepage": "https://modrinth.com/mod/MEVdpviL",
		"sources": "https://github.com/creeperkatze/mc-mods/tree/main/${mod_folder}",
		"issues": "https://github.com/creeperkatze/mc-mods/issues"
	},
	"license": "${mod_license}",
	"icon": "assets/accelerate/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.creeperkatze.accelerate.loaders.fabric.AccelerateFabric"],
		"modmenu": ["dev.creeperkatze.accelerate.compat.modmenu.AccelerateModMenuCompat"]
	},
	"mixins": ["accelerate.mixins.json"],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"yet_another_config_lib_v3": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/Qds5QMrnDv",
				"modmenu.donate": "https://ko-fi.com/creeperkatze"
			}
		}
	}
}
