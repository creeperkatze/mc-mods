{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"creeperkatze"
	],
	"contact": {
		"sources": "https://github.com/creeperkatze/mc-mods",
		"issues": "https://github.com/creeperkatze/mc-mods/issues"
	},
	"license": "${mod_license}",
	"icon": "assets/speed-dial/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.creeperkatze.speeddial.SpeedDial"
		],
		"modmenu": [
			"dev.creeperkatze.speeddial.compat.modmenu.SpeedDialModMenuCompat"
		]
	},
	"mixins": [
		"speed-dial.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
