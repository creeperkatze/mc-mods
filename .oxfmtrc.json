{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"overrides": [
		{
			"files": ["*.md", "*.yml", "*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		},
		{
			"files": ["*.json", "*.jsonc"],
			"options": {
				"trailingComma": "none"
			}
		}
	],
	"ignorePatterns": [
		"**/build/",
		"**/bin/",
		"run/",
		"speed-dial/versions/",
		"**/package.json",
		"pnpm-lock.yaml",
		"**/*.mods.toml"
	]
}
