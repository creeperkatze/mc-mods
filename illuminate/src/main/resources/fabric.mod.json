{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": ["Creeperkatze"],
	"contact": {
		"homepage": "https://github.com/creeperkatze/mc-mods/tree/main/${mod_folder}",
		"sources": "https://github.com/creeperkatze/mc-mods/tree/main/${mod_folder}",
		"issues": "https://github.com/creeperkatze/mc-mods/issues"
	},
	"license": "${mod_license}",
	"icon": "assets/illuminate/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.creeperkatze.illuminate.loaders.fabric.IlluminateFabric"],
		"modmenu": ["dev.creeperkatze.illuminate.compat.modmenu.IlluminateModMenuCompat"]
	},
	"mixins": ["illuminate.mixins.json"],
	"depends": {
		"fabricloader": ">=${fabric_loader_minimum}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"yet_another_config_lib_v3": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/Qds5QMrnDv",
				"modmenu.donate": "https://ko-fi.com/creeperkatze"
			}
		}
	}
}
